# Resend API Key
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Client URL (for invite links)
CLIENT_URL=http://localhost:5173

# Contact form inbox (required in production; sendContactEmail fails closed if unset)
CONTACT_EMAIL=

# Comma-separated site origins allowed to call public HTTP functions
# ALLOWED_ORIGINS=https://stealorreveal.com,https://www.stealorreveal.com

# Requires Firebase App Check on the contact form (default off)
# ENFORCE_CONTACT_APP_CHECK=false
