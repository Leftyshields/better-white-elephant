{
  "name": "better-white-elephant-client",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=src/test/e2e/playwright.config.js",
    "test:e2e:ui": "xvfb-run -a playwright test --ui --ui-host=0.0.0.0 --ui-port=9323 --config=src/test/e2e/playwright.config.js",
    "test:e2e:debug": "xvfb-run -a playwright test --debug --config=src/test/e2e/playwright.config.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.90.12",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.6.1",
    "framer-motion": "^14.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
