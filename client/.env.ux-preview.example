# Copy to client/.env.ux-preview (local) or set as CI secrets for the UX preview Firebase project.
# Project must NOT be better-white-elephant (production).

VITE_FIREBASE_API_KEY=your-ux-preview-api-key
VITE_FIREBASE_AUTH_DOMAIN=better-white-elephant-ux-preview.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=better-white-elephant-ux-preview
VITE_FIREBASE_STORAGE_BUCKET=better-white-elephant-ux-preview.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Preview game server (staging Cloud Run wired to the same preview Firebase project — never production API)
VITE_SERVER_URL=https://your-preview-game-server.example.com

# Optional: only for local emulator workflow (never set on hosted preview builds)
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
