{
  "name": "better-white-elephant",
  "version": "1.0.0",
  "description": "Real-time White Elephant gift exchange platform",
  "private": false,
  "workspaces": [
    "client",
    "server",
    "functions"
  ],
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build:client": "cd client && npm run build",
    "build:functions": "cd functions && npm run build",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project better-white-elephant-rules-test 'node --test tests/firestore.users.rules.test.mjs'"
  },
  "keywords": [
    "white-elephant",
    "gift-exchange",
    "firebase",
    "socket.io"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase": "^13.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.35.0"
  }
}
