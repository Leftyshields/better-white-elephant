rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Hosts must be signed in with Google. Never trust email, email_verified, or auth != null alone.
    function isGoogleUser() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Helper function to check if user is party admin (Google sign-in required for every admin path)
    function isPartyAdmin(partyId) {
      return isGoogleUser() &&
             get(/databases/$(database)/documents/parties/$(partyId)).data.adminId == request.auth.uid;
    }

    function partyPath(partyId) {
      return /databases/$(database)/documents/parties/$(partyId);
    }

    function participantPath(partyId, uid) {
      return /databases/$(database)/documents/parties/$(partyId)/participants/$(uid);
    }

    function inviteTokenPath(partyId) {
      return /databases/$(database)/documents/parties/$(partyId)/private/invite;
    }

    function joinProofPath(partyId, uid) {
      return /databases/$(database)/documents/parties/$(partyId)/joinProofs/$(uid);
    }

    // Per-party seat cap. parties/{id}.participantCount moves by exactly 1 in the same batch as
    // each participant create (+1) or delete (-1); legacy parties without the field count from 0.
    function maxParticipants() {
      return 30;
    }

    function participantCountOf(data) {
      return data.get('participantCount', 0);
    }

    // 128-bit token as 32 lowercase hex chars (client crypto.getRandomValues or server randomBytes).
    function validInviteToken(token) {
      return token is string && token.matches('^[0-9a-f]{32}$');
    }

    function inviteTokenDocValid() {
      return request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && validInviteToken(request.resource.data.token);
    }

    // Party is being created in this same batch by the caller (host bootstrap).
    function isCreatingPartyAsHost(partyId) {
      return isGoogleUser()
        && !exists(partyPath(partyId))
        && getAfter(partyPath(partyId)).data.adminId == request.auth.uid;
    }

    // A non-host joins with the invite token: proof doc in the same batch must match the stored token.
    function joinTokenMatches(partyId) {
      return getAfter(joinProofPath(partyId, request.auth.uid)).data.token
        == get(inviteTokenPath(partyId)).data.token;
    }

    // Join = participant create while LOBBY, under the cap, with the count bumped by 1 in the same batch.
    function participantJoinAllowed(partyId) {
      let before = get(partyPath(partyId)).data;
      let afterCount = participantCountOf(getAfter(partyPath(partyId)).data);
      return before.status == 'LOBBY'
        && afterCount == participantCountOf(before) + 1
        && afterCount <= maxParticipants()
        && (isPartyAdmin(partyId) || joinTokenMatches(partyId));
    }

    // Party doc side of a join: only participantCount changes, +1, and the caller's seat appears.
    function participantCountJoinBump(partyId) {
      return isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
        && resource.data.status == 'LOBBY'
        && request.resource.data.participantCount == participantCountOf(resource.data) + 1
        && request.resource.data.participantCount <= maxParticipants()
        && !exists(participantPath(partyId, request.auth.uid))
        && existsAfter(participantPath(partyId, request.auth.uid));
    }

    // Host removing a participant must decrement the counter in the same batch (counted parties only).
    function participantRemovalCounted(partyId) {
      let before = get(partyPath(partyId)).data;
      return !before.keys().hasAny(['participantCount'])
        || getAfter(partyPath(partyId)).data.participantCount == before.participantCount - 1;
    }

    function adminParticipantCountChangeOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantCount'])
        || (
          resource.data.keys().hasAny(['participantCount'])
          && request.resource.data.participantCount == resource.data.participantCount - 1
          && request.resource.data.participantCount >= 1
        );
    }
    
    // Helper function to check if user is a participant in a party
    function isParticipant(partyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/parties/$(partyId)/participants/$(request.auth.uid));
    }

  // Party is still in pre-game setup (client may edit gifts and lobby settings)
    function partyIsLobby(partyId) {
      return get(/databases/$(database)/documents/parties/$(partyId)).data.status == 'LOBBY';
    }

    // Public host label on party docs (invite landing — matches PR #91 validation)
    function validHostDisplayName(name) {
      return name is string
        && name.matches('^\\S(.{0,62}\\S)?$')
        && name.size() <= 64
        && !name.matches('.*@.*');
    }

    function hostDisplayNameOkOnWrite() {
      return !request.resource.data.keys().hasAny(['hostDisplayName'])
        || validHostDisplayName(request.resource.data.hostDisplayName);
    }

    function partyServerFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['gameState', 'gameStateUpdatedAt', 'endedAt', 'gameHistory', 'adminId', 'createdAt']);
    }

    function partyAdminUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['title', 'date', 'config', 'updatedAt', 'status', 'hostDisplayName', 'participantCount'])
        && partyServerFieldsUntouched()
        && adminParticipantCountChangeOk()
        && hostDisplayNameOkOnWrite()
        && request.resource.data.status != 'ACTIVE'
        && request.resource.data.status != 'ENDED'
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'LOBBY' && request.resource.data.status == 'CANCELLED')
        );
    }

    function giftCreateValid() {
      return request.resource.data.submitterId == request.auth.uid
        && request.resource.data.winnerId == null
        && request.resource.data.isFrozen == false
        && request.resource.data.keys().hasOnly([
          'partyId', 'submitterId', 'url', 'title', 'image', 'price',
          'isFrozen', 'winnerId', 'createdAt', 'updatedAt'
        ]);
    }

    function giftProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['submitterId', 'partyId', 'createdAt', 'winnerId', 'isFrozen', 'partyEndedAt']);
    }

    function giftSubmitterUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['url', 'title', 'image', 'price', 'updatedAt']);
    }

    function validUserDisplayName(name) {
      return name is string && name.size() <= 64;
    }

    function validUserEmail(email) {
      return email is string && email.size() <= 320;
    }

    function validShippingAddress(addr) {
      return addr == null
        || (
          addr is map
          && addr.keys().hasOnly(['name', 'street', 'city', 'state', 'zip', 'country'])
          && (!addr.keys().hasAny(['name']) || (addr.name is string && addr.name.size() <= 100))
          && (!addr.keys().hasAny(['street']) || (addr.street is string && addr.street.size() <= 200))
          && (!addr.keys().hasAny(['city']) || (addr.city is string && addr.city.size() <= 100))
          && (!addr.keys().hasAny(['state']) || (addr.state is string && addr.state.size() <= 50))
          && (!addr.keys().hasAny(['zip']) || (addr.zip is string && addr.zip.size() <= 20))
          && (!addr.keys().hasAny(['country']) || (addr.country is string && addr.country.size() <= 60))
        );
    }

    function validShippingConsentTimestamp() {
      return !request.resource.data.keys().hasAny(['shippingAddressSenderShareConsentAt'])
        || request.resource.data.shippingAddressSenderShareConsentAt is timestamp;
    }

    function userProfileWritableKeys() {
      return [
        'displayName', 'email', 'shippingAddress', 'shippingAddressSenderShareConsentAt',
        'createdAt', 'updatedAt',
      ];
    }

    function userCreateAllowed() {
      return request.resource.data.keys().hasOnly(userProfileWritableKeys())
        && validUserDisplayName(request.resource.data.displayName)
        && validUserEmail(request.resource.data.email)
        && validShippingAddress(request.resource.data.get('shippingAddress', null))
        && validShippingConsentTimestamp();
    }

    function userUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(userProfileWritableKeys())
        && (!changed.hasAny(['displayName']) || validUserDisplayName(request.resource.data.displayName))
        && (!changed.hasAny(['email']) || validUserEmail(request.resource.data.email))
        && (!changed.hasAny(['shippingAddress'])
            || validShippingAddress(request.resource.data.get('shippingAddress', null)))
        && (!changed.hasAny(['shippingAddressSenderShareConsentAt']) || validShippingConsentTimestamp());
    }
    
    // Users collection
    match /users/{userId} {
      // Owner-only reads: email, shippingAddress, and profile fields are never public.
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      
      allow create: if isOwner(userId) && userCreateAllowed();
      allow update: if isOwner(userId) && userUpdateAllowed();
    }
    
    // Parties collection
    match /parties/{partyId} {
      // Single-doc reads stay open for now so the signed-out invite landing keeps working
      // (to be tightened to host + seated players in a later step).
      allow get: if true;
      // Listing parties is host-only: the query itself must filter adminId == the caller's uid.
      // Nobody (signed out or signed in) can list other people's parties.
      allow list: if isAuthenticated() && resource.data.adminId == request.auth.uid;
      
      // Only Google-signed-in users can create parties (must start in LOBBY; no server-owned fields).
      // One batch writes the party, the host's participant seat (count 1) and the invite token.
      allow create: if isGoogleUser() &&
                       request.resource.data.adminId == request.auth.uid &&
                       request.resource.data.status == 'LOBBY' &&
                       request.resource.data.participantCount == 1 &&
                       existsAfter(participantPath(partyId, request.auth.uid)) &&
                       existsAfter(inviteTokenPath(partyId)) &&
                       hostDisplayNameOkOnWrite() &&
                       !request.resource.data.keys().hasAny([
                         'gameState', 'gameStateUpdatedAt', 'endedAt', 'gameHistory'
                       ]);
      
      // Party admin: allowlisted lobby fields only; cannot set ACTIVE/ENDED or touch gameState.
      // Anyone joining may bump participantCount by exactly 1 alongside their own participant create.
      allow update: if (isPartyAdmin(partyId) && partyAdminUpdateAllowed())
                    || participantCountJoinBump(partyId);
      
      // Only party admin can delete party, and only if it's ended or cancelled
      allow delete: if isPartyAdmin(partyId) && 
                      (resource.data.status == 'ENDED' || resource.data.status == 'CANCELLED');
      
      // Participants subcollection
      match /participants/{participantId} {
        // Participants can read all participants in their party
        // Also allow authenticated users to read if party is in LOBBY (so they can see list while joining)
        // Also allow users to read their own participant document (for collectionGroup queries)
        allow read: if isAuthenticated() && 
                     (participantId == request.auth.uid ||
                      isParticipant(partyId) || 
                      get(/databases/$(database)/documents/parties/$(partyId)).data.status == 'LOBBY');
        
        // Users create their own participant record: as the host in the party-create batch, or as a
        // join (LOBBY only, invite token proof, counter +1, cap 30)
        allow create: if isAuthenticated() &&
                        participantId == request.auth.uid &&
                        (isCreatingPartyAsHost(partyId) || participantJoinAllowed(partyId));
        
        // Users can update their own participant status
        allow update: if isAuthenticated() && 
                        (participantId == request.auth.uid || isPartyAdmin(partyId));
        
        // Only admin can delete participants, decrementing participantCount in the same batch
        allow delete: if isPartyAdmin(partyId) && participantRemovalCounted(partyId);
      }

      // Invite token (128-bit). Only the Google host may read, create or rotate it.
      match /private/{docId} {
        allow read: if docId == 'invite' && isPartyAdmin(partyId);
        allow create: if docId == 'invite' &&
                        (isPartyAdmin(partyId) || isCreatingPartyAsHost(partyId)) &&
                        inviteTokenDocValid();
        allow update: if docId == 'invite' && isPartyAdmin(partyId) && inviteTokenDocValid();
        allow delete: if false;
      }

      // Join proof: written only in the join batch, never readable by clients (keeps the token
      // off participant docs, which other signed-in users can read during LOBBY).
      match /joinProofs/{uid} {
        allow read: if false;
        allow create, update: if isOwner(uid) &&
                                request.resource.data.keys().hasOnly(['token']) &&
                                request.resource.data.token == get(inviteTokenPath(partyId)).data.token &&
                                !exists(participantPath(partyId, uid)) &&
                                existsAfter(participantPath(partyId, uid));
        allow delete: if false;
      }
      
      // Pending invites subcollection
      match /pendingInvites/{inviteId} {
        // Only party admin can read/manage invites
        allow read, write: if isPartyAdmin(partyId);
      }
    }
    
    // Gifts collection
    match /gifts/{giftId} {
      // Participants can read gifts in their party
      // Also allow authenticated users to read if party is in LOBBY (so they can see gifts while joining)
      allow read: if isAuthenticated() && 
                     (isParticipant(resource.data.partyId) || 
                      get(/databases/$(database)/documents/parties/$(resource.data.partyId)).data.status == 'LOBBY');
      
      // Create while party is LOBBY; caller must hold a seat; submitterId must match auth
      allow create: if isAuthenticated() && 
                       giftCreateValid() &&
                       partyIsLobby(request.resource.data.partyId) &&
                       isParticipant(request.resource.data.partyId);
      
      // Submitter may update gift metadata only while party is LOBBY (submitterId immutable)
      allow update: if isAuthenticated() && 
                       resource.data.submitterId == request.auth.uid &&
                       partyIsLobby(resource.data.partyId) &&
                       giftProtectedFieldsUnchanged() &&
                       giftSubmitterUpdateAllowed();
      
      // Submitter or admin may delete gifts during lobby (Change Gift / remove participant)
      allow delete: if isAuthenticated() && 
                       partyIsLobby(resource.data.partyId) &&
                       (resource.data.submitterId == request.auth.uid ||
                        isPartyAdmin(resource.data.partyId));
    }
    
    // Collection group query for participants - allows users to find parties where they are participants
    // This is needed for the Home page to show parties where user is a participant
    match /{path=**}/participants/{participantId} {
      // Allow users to read participant documents where the document ID matches their user ID
      // This enables collectionGroup queries to find parties where the user is a participant
      allow read: if isAuthenticated() && participantId == request.auth.uid;
    }

    // Invite rate-limit counters: Cloud Functions (Admin SDK) only
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }
  }
}
